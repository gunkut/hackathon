{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TazeRotaOrdersReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/tazerota-orders"
    },
    {
      "Sid": "TazeRotaApprovalStatusUpdate",
      "Effect": "Allow",
      "Action": ["dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:*:*:table/tazerota-approvals"
    }
  ]
}
